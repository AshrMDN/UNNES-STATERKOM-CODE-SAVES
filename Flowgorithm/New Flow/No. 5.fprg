<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="No. 5"/>
        <attribute name="authors" value="ASUS"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-15 10.00.01 AM"/>
        <attribute name="created" value="QVNVUztNRE5QQzsyMDI2LTA5LTE1OzA5LjMxLjI3IEFNOzE5Mzg="/>
        <attribute name="edited" value="QVNVUztNRE5QQzsyMDI2LTA5LTE1OzEwLjAwLjAxIEFNOzM7MjAyOA=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="a, b, Hasil" type="Real" array="False" size=""/>
            <declare name="Operator" type="String" array="False" size=""/>
            <output expression="&quot;Input Nilai Pertama&quot;" newline="True"/>
            <input variable="a"/>
            <output expression="&quot;Input Operator: (+,-,*,/)&quot;" newline="True"/>
            <input variable="Operator"/>
            <output expression="&quot;Input Nilai Kedua&quot;" newline="True"/>
            <input variable="b"/>
            <if expression="Operator == &quot;+&quot;">
                <then>
                    <assign variable="Hasil" expression="a+b"/>
                </then>
                <else>
                    <if expression="Operator == &quot;-&quot;">
                        <then>
                            <assign variable="Hasil" expression="a-b"/>
                        </then>
                        <else>
                            <if expression="Operator == &quot;*&quot;">
                                <then>
                                    <assign variable="Hasil" expression="a*b"/>
                                </then>
                                <else>
                                    <if expression="Operator == &quot;/&quot;">
                                        <then>
                                            <assign variable="Hasil" expression="a/b"/>
                                        </then>
                                        <else>
                                            <output expression="&quot;Error tidak ada operasi&quot;" newline="True"/>
                                        </else>
                                    </if>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
            <output expression="&quot;Hasil Operasi:&quot;" newline="True"/>
            <output expression="Hasil" newline="True"/>
        </body>
    </function>
</flowgorithm>
